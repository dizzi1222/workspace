# PreMiD: sirve las actividades Exercism, Mimo, CodeCrafters, CryptoZombies y Speedrun Ethereum
# a la extensión PreMiD (premid-serve.mjs, versión ligera de `pmd dev`). La extensión, con
# "Activity Developer" activado, se conecta a ws://localhost:3021 y recibe el dist/ de cada
# actividad; solo se compila (`pmd build`) al arrancar si dist/ está desactualizado o al guardar
# cambios.
# Lo instala ~/workspace/systemd/premid-dev-install.sh (setup.sh y ~/bazzite-install.sh).
[Unit]
Description=PreMiD: actividades Exercism, Mimo, CodeCrafters, CryptoZombies y Speedrun Ethereum (premid-serve)
Documentation=https://docs.premid.app/v1/guide/loading-activities

[Service]
Type=simple
WorkingDirectory=%h/workspace/premid-activities
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
# Nombres con espacios, entre comillas dobles: "Speedrun Ethereum".
ExecStart=/usr/bin/env node %h/workspace/systemd/premid-serve.mjs Exercism Mimo CodeCrafters CryptoZombies "Speedrun Ethereum"
# always: también vuelve si algo externo lo mata con SIGTERM (on-failure lo daría por bueno).
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=premid-dev

[Install]
WantedBy=default.target
