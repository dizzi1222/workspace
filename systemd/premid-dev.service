# PreMiD: deja `pmd dev Exercism` siempre corriendo para la extensión PreMiD.
# La extensión (con "Activity Developer" activado) se conecta a ws://localhost:3021
# y este proceso le envía la actividad compilada; también recarga al guardar cambios.
# Lo instala ~/workspace/setup.sh en ~/.config/systemd/user/premid-dev.service
[Unit]
Description=PreMiD pmd dev (actividad Exercism para la extensión PreMiD)
Documentation=https://docs.premid.app/v1/guide/loading-activities

[Service]
Type=simple
WorkingDirectory=%h/workspace/premid-activities
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/workspace/premid-activities/node_modules/.bin/pmd dev Exercism
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=premid-dev

[Install]
WantedBy=default.target
